# Mot de passe d'accès. Laisser vide = aucune authentification.
APP_PASSWORD=

# Secret de signature du cookie de session (32 octets aléatoires)
AUTH_SECRET=change-moi

# Secret attendu par /api/cron/notify (Vercel l'envoie en Bearer, ou ?secret=...)
CRON_SECRET=change-moi

# Clés VAPID — générer avec: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com

# Base de données — ajoutée automatiquement par l'intégration Vercel Postgres / Neon
POSTGRES_URL=

# ---------------------------------------------------------------------------
# Network (réseau d'entrepreneurs) — s'active seul quand APP_PASSWORD,
# AUTH_SECRET (32 caractères aléatoires minimum) et POSTGRES_URL sont définis.
# Facultatif : code à donner aux personnes autorisées à s'inscrire.
# NETWORK_INVITE_CODE=

# ---------------------------------------------------------------------------
# Connexion bancaire — OPTIONNEL, non configuré par défaut.
#
# L'utilisateur s'authentifie sur le site de sa propre banque via un
# prestataire agréé DSP2 : l'app ne voit et ne stocke jamais ses identifiants.
# Seul Enable Banking est branché (les autres fournisseurs ci-dessous sont
# listés mais n'ont pas de connecteur).
#
# La connexion est REFUSÉE tant que ces deux conditions ne sont pas remplies :
#   - APP_PASSWORD défini (l'app est protégée par un mot de passe) ;
#   - AUTH_SECRET défini, 32 caractères aléatoires minimum (pas la valeur par défaut).

# Enable Banking — https://enablebanking.com (Control Panel → application,
# environnement Production, mode restreint gratuit pour ses propres comptes).
# URL de redirection à déclarer : https://<ton-domaine>/api/bank/callback
ENABLEBANKING_APP_ID=
# Clé privée RSA de l'application, au format PEM (les retours à la ligne
# peuvent être écrits \n sur une seule ligne).
ENABLEBANKING_PRIVATE_KEY=
# Facultatif : force l'URL de retour si elle diffère de l'adresse du site.
# ENABLEBANKING_REDIRECT_URL=

# Facultatif : clé de chiffrement des sessions bancaires (32 octets en base64,
# ex. `openssl rand -base64 32`). Par défaut, dérivée de AUTH_SECRET.
# BANK_ENCRYPTION_KEY=
# Facultatif : délai minimal entre deux synchronisations (secondes, 120 par défaut).
# BANK_SYNC_COOLDOWN_SECONDS=

# Powens (ex-Budget Insight) — https://docs.powens.com
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_DOMAIN=

# Bridge by Bankin' — https://docs.bridgeapi.io
# BRIDGE_CLIENT_ID=
# BRIDGE_CLIENT_SECRET=

# GoCardless Bank Account Data — https://developer.gocardless.com/bank-account-data
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=

# Tink — https://docs.tink.com
# TINK_CLIENT_ID=
# TINK_CLIENT_SECRET=

# Plaid — https://plaid.com/docs
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=

# ---------------------------------------------------------------------------
# Cotations de marché — OPTIONNEL, non configuré par défaut.
#
# Sans fournisseur, la valeur actuelle de chaque position reste celle que tu
# saisis à la main : aucune valorisation n'est inventée.
# Connecteur à implémenter dans src/app/api/market/quote/route.ts.

# Twelve Data — https://twelvedata.com/docs
TWELVEDATA_API_KEY=

# Finnhub — https://finnhub.io/docs/api
# FINNHUB_API_KEY=

# CoinGecko — https://docs.coingecko.com
# COINGECKO_API_KEY=
