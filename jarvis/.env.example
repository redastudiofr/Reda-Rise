# Copiez ce fichier en .env.local (jamais commité) et remplissez-le.

# --- Accès au site (obligatoires) ---
# Mot de passe demandé à l'ouverture du site.
JARVIS_PASSWORD=
# Au moins 32 caractères aléatoires. Générer : openssl rand -base64 48
SESSION_SECRET=

# --- Gemini (gratuit : https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Facultatif : dernier modèle Flash au 05/11/2026.
GEMINI_MODEL=gemini-3.8-flash

# --- Google OAuth (Gmail lecture seule + Agenda) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : par défaut, <adresse du site>/api/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# --- Shopify : une boutique par numéro (1 à 10) ---
SHOPIFY_SHOP_1_NAME=Reda Studio
SHOPIFY_SHOP_1_DOMAIN=ma-boutique.myshopify.com
# Soit un jeton d'accès Admin API (shpat_…) :
SHOPIFY_SHOP_1_TOKEN=
# Soit une app du Dev Dashboard (à la place du jeton) :
# SHOPIFY_SHOP_1_CLIENT_ID=
# SHOPIFY_SHOP_1_CLIENT_SECRET=

# SHOPIFY_SHOP_2_NAME=
# SHOPIFY_SHOP_2_DOMAIN=
# SHOPIFY_SHOP_2_TOKEN=

# --- Stockage (obligatoire sur Vercel, facultatif en local) ---
# Postgres gratuit (Neon). Sans cette variable : fichier .data/store.json en local.
# DATABASE_URL=postgres://…
